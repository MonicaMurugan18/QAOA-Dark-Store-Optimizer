# ---------------------------------------------------------------------------
# Copy to .env and fill in your own values.  NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- database -------------------------------------------------------------
# PostgreSQL (intended target). Replace USER, PASSWORD, HOST, PORT, DBNAME.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/darkstore

# Local fallback that needs no server. Handy for running the test suite.
# DATABASE_URL=sqlite:///./darkstore.db

# Echo every SQL statement to the log (noisy; debugging only).
SQL_ECHO=false

# --- application ----------------------------------------------------------
DEBUG=false

# --- optimization model ---------------------------------------------------
# Margin earned per rupee of demand value served. Quick commerce is thin:
# 0.15-0.25 is the realistic band.
GROSS_MARGIN=0.18

# Rider economics. Delivery cost for one store-area link is
#   RIDER_COST_PER_MIN * delivery_time_min * number_of_orders
RIDER_COST_PER_MIN=3.0
AVG_ITEMS_PER_ORDER=5.0

# Fallback service promise in minutes when an area does not declare its own.
DEFAULT_DELIVERY_TIME_LIMIT=15.0

# --- solver limits --------------------------------------------------------
# A statevector simulation holds 2**n complex amplitudes. 20 qubits is about
# 1 million; 30 would be a billion and the process dies. Requests above this
# are rejected with a clear message rather than allowed to exhaust memory.
QAOA_MAX_QUBITS=20
QAOA_DEFAULT_REPS=3
QAOA_DEFAULT_MAXITER=200
QAOA_DEFAULT_SHOTS=2048

# CBC time limit, seconds. If CBC hits this, its answer is the best found and
# is NOT treated as a proven optimum.
CLASSICAL_TIME_LIMIT_SEC=60
